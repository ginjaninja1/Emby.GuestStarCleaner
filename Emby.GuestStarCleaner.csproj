<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyVersion>0.1.0.2</AssemblyVersion>
    <FileVersion>0.1.0.2</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Models\**" />
    <EmbeddedResource Remove="Models\**" />
    <None Remove="Models\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="thumb.jpg" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\PluginTab2ConfigurationPage.html" />
    <EmbeddedResource Include="Configuration\PluginTab2ConfigurationPage.js" />
    <EmbeddedResource Include="Configuration\PluginTab3ConfigurationPage.html" />
    <EmbeddedResource Include="Configuration\PluginTab3ConfigurationPage.js" />
    <EmbeddedResource Include="Configuration\GSCleanerConfigurationPage.html" />
    <EmbeddedResource Include="Configuration\GSCleanerConfigurationPage.js" />
    <EmbeddedResource Include="Configuration\PluginNameSettings.html" />
    <EmbeddedResource Include="Configuration\PluginNameSettings.js" />
    <EmbeddedResource Include="thumb.jpg" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" />
		<PackageReference Include="System.Memory" Version="4.6.0" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="xcopy &quot;$(TargetPath)&quot; &quot;%25appdata%25\Emby-Server\programdata\plugins\&quot; /Y" />
	</Target>

</Project>
